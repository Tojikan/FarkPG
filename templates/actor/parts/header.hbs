<header class="farkpg-header">
    <div class="farkpg-portrait" {{#if editable}}data-tooltip="{{localize 'FARKPG.Header.portraitEditHint'}}"{{/if}}>
        <img class="farkpg-portrait-img"
             src="{{actor.img}}"
             alt="{{actor.name}}"
             {{#if editable}}data-farkpg-portrait-picker="1"{{/if}} />
        {{#if editable}}
            <button type="button"
                    class="farkpg-portrait-edit"
                    data-action="editPortrait"
                    data-tooltip="{{localize 'FARKPG.Header.portraitEditBtn'}}"
                    aria-label="{{localize 'FARKPG.Header.portraitEditBtn'}}">
                <i class="fa-solid fa-image" aria-hidden="true"></i>
            </button>
        {{/if}}
    </div>

    <div class="farkpg-header-body">
        <div class="farkpg-header-row farkpg-header-name farkpg-header-name-row">
            <input type="text"
                   class="farkpg-header-name-input"
                   name="name"
                   value="{{actor.name}}"
                   placeholder="{{localize 'FARKPG.Header.name'}}" />
            {{#if editable}}
                <button type="button"
                        class="farkpg-header-import"
                        data-action="openCharacterImport"
                        data-tooltip="{{localize 'FARKPG.Import.buttonTooltip'}}"
                        aria-label="{{localize 'FARKPG.Import.buttonAria'}}">
                    {{localize "FARKPG.Import.button"}}
                </button>
            {{/if}}
        </div>

        <div class="farkpg-header-row farkpg-resources farkpg-resources-primary farkpg-header-resources-strip">
            <div class="farkpg-resource farkpg-resource-hp">
                <span class="farkpg-resource-label">{{localize 'FARKPG.Header.hp'}}</span>
                <div class="farkpg-resource-fields farkpg-drawer-health-value farkpg-header-resource-inner">
                    <span class="farkpg-resource-delta-anchor">
                        {{#if editable}}
                            <button type="button"
                                    class="farkpg-header-icon-hit farkpg-header-hp-delta farkpg-header-icon-hit--hp"
                                    data-tooltip="{{localize 'FARKPG.ResourceDelta.hpTooltip'}}"
                                    aria-label="{{localize 'FARKPG.ResourceDelta.hpAria'}}">
                                <i class="fa-solid fa-heart" aria-hidden="true"></i>
                            </button>
                        {{else}}
                            <span class="farkpg-header-icon-hit farkpg-header-icon-readonly farkpg-header-icon-hit--hp" aria-hidden="true">
                                <i class="fa-solid fa-heart" aria-hidden="true"></i>
                            </span>
                        {{/if}}
                    </span>
                    {{#if editable}}
                        <input type="number"
                               class="farkpg-header-ghost-inp"
                               name="system.resources.health.value"
                               value="{{system.resources.health.value}}"
                               min="0"
                               step="1" />
                        <span class="farkpg-ap-drawer-slash">/</span>
                        <input type="number"
                               class="farkpg-header-ghost-inp farkpg-resource-max-input"
                               name="system.resources.health.max"
                               value="{{system.resources.health.max}}"
                               min="0"
                               step="1"
                               data-tooltip="{{localize 'FARKPG.Config.maxHealth'}}" />
                    {{else}}
                        <span class="farkpg-header-read-val">{{resourceDisplay.hpValue}}</span>
                        <span class="farkpg-ap-drawer-slash">/</span>
                        <span class="farkpg-header-read-max">{{resourceDisplay.hpMax}}</span>
                    {{/if}}
                </div>
            </div>

            <div class="farkpg-resource farkpg-resource-exp">
                <span class="farkpg-resource-label">{{localize 'FARKPG.Header.exp'}}</span>
                <div class="farkpg-resource-fields farkpg-drawer-health-value farkpg-header-resource-inner">
                    <span class="farkpg-resource-delta-anchor">
                        {{#if editable}}
                            <button type="button"
                                    class="farkpg-header-icon-hit farkpg-header-exp-delta"
                                    data-tooltip="{{localize 'FARKPG.ResourceDelta.expTooltip'}}"
                                    aria-label="{{localize 'FARKPG.ResourceDelta.expAria'}}">
                                <i class="fa-solid fa-star" aria-hidden="true"></i>
                            </button>
                        {{else}}
                            <span class="farkpg-header-icon-readonly farkpg-header-icon-hit farkpg-header-icon-hit--exp" aria-hidden="true">
                                <i class="fa-solid fa-star" aria-hidden="true"></i>
                            </span>
                        {{/if}}
                    </span>
                    {{#if editable}}
                        <input type="number"
                               class="farkpg-header-ghost-inp"
                               name="system.resources.exp.value"
                               value="{{system.resources.exp.value}}"
                               min="0"
                               step="1" />
                        <span class="farkpg-ap-drawer-slash">/</span>
                        <input type="number"
                               class="farkpg-header-ghost-inp farkpg-resource-max-input"
                               name="system.resources.exp.max"
                               value="{{system.resources.exp.max}}"
                               min="0"
                               step="1"
                               data-tooltip="{{localize 'FARKPG.Config.maxExp'}}" />
                    {{else}}
                        <span class="farkpg-header-read-val">{{resourceDisplay.expValue}}</span>
                        <span class="farkpg-ap-drawer-slash">/</span>
                        <span class="farkpg-header-read-max">{{resourceDisplay.expMax}}</span>
                    {{/if}}
                </div>
            </div>

            <div class="farkpg-resource farkpg-resource-move">
                <span class="farkpg-resource-label">{{localize 'FARKPG.Header.move'}}</span>
                <div class="farkpg-resource-fields farkpg-header-resource-inner">
                    {{#if editable}}
                        <input type="number"
                               class="farkpg-header-ghost-inp farkpg-header-move-val"
                               name="system.resources.movement"
                               value="{{system.resources.movement}}"
                               min="0"
                               step="1" />
                    {{else}}
                        <span class="farkpg-header-read-val farkpg-header-move-val">{{resourceDisplay.move}}</span>
                    {{/if}}
                </div>
            </div>
        </div>

        <div class="farkpg-header-row farkpg-header-ap-row">
            {{#each apTypes as |row|}}
                <div class="farkpg-ap-panel farkpg-ap-bar">
                    <span class="farkpg-resource-label farkpg-ap-panel-label">{{localize 'FARKPG.Header.ap'}}</span>
                    <div class="farkpg-ap-panel-body">
                        <div class="farkpg-ap-controls farkpg-resource-fields farkpg-header-resource-inner">
                            <span class="farkpg-resource-delta-anchor">
                                {{#if editable}}
                                    <button type="button"
                                            class="farkpg-header-icon-hit farkpg-header-ap-delta farkpg-header-icon-hit--ap"
                                            data-tooltip="{{localize 'FARKPG.ResourceDelta.apTooltip'}}"
                                            aria-label="{{localize 'FARKPG.ResourceDelta.apAria'}}">
                                        <i class="fa-solid fa-coins" aria-hidden="true"></i>
                                    </button>
                                {{else}}
                                    <span class="farkpg-header-icon-hit farkpg-header-icon-readonly farkpg-header-icon-hit--ap" aria-hidden="true">
                                        <i class="fa-solid fa-coins" aria-hidden="true"></i>
                                    </span>
                                {{/if}}
                            </span>
                            <input type="number"
                                   class="farkpg-ap-drawer-inp farkpg-ap-drawer-inp-val farkpg-ap-sheet-inp farkpg-header-ghost-inp"
                                   data-ap-path="{{row.valuePath}}"
                                   value="{{row.value}}"
                                   min="0"
                                   step="1" />
                        </div>
                        <div class="farkpg-ap-chips-wrap farkpg-ap-white-pool farkpg-ap-drawer-cell farkpg-ap-sheet-cell farkpg-ac-cell farkpg-ac-cell--{{row.id}}"
                             data-ap-id="{{row.id}}">
                        <div class="farkpg-ac-chip-mid">
                            {{#if editable}}
                                <button type="button"
                                        class="farkpg-ac-icon-hit farkpg-ac-icon-hit--sheet"
                                        data-action="decrementApFromSheet"
                                        data-ap-id="{{row.id}}"
                                        data-tooltip="{{localize 'FARKPG.ApDrawer.decrementTooltip'}}"
                                        aria-label="{{localize 'FARKPG.ApDrawer.decrementAria'}}">
                                    {{> "farkpg.chip-stack"
                                           chipClass=row.chipClass
                                           chipCount=row.chipCount
                                           chipColCount=row.chipColCount
                                           chipCountClass=row.chipCountClass
                                           chipColsClass=row.chipColsClass
                                           chipOver=row.chipOver
                                           chipStackSize="farkpg-chip-stack--sheet"}}
                                </button>
                            {{else}}
                                {{> "farkpg.chip-stack"
                                       chipClass=row.chipClass
                                       chipCount=row.chipCount
                                       chipColCount=row.chipColCount
                                       chipCountClass=row.chipCountClass
                                       chipColsClass=row.chipColsClass
                                       chipOver=row.chipOver
                                       chipStackSize="farkpg-chip-stack--sheet"}}
                            {{/if}}
                        </div>
                        </div>
                    </div>
                </div>
            {{/each}}
            <button type="button"
                    class="farkpg-ap-bar-btn farkpg-ap-bar-popout"
                    data-action="openApDrawer"
                    data-tooltip="{{localize 'FARKPG.ApDrawer.openTooltip'}}"
                    aria-label="{{localize 'FARKPG.ApDrawer.openAria'}}">
                <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</header>
