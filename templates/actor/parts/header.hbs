<header class="farkpg-header">
    <div class="farkpg-portrait" {{#if editable}}data-tooltip="{{localize 'FARKPG.Header.portraitEditHint'}}"{{/if}}>
        <img class="farkpg-portrait-img"
             src="{{actor.img}}"
             alt="{{actor.name}}"
             {{#if editable}}data-farkpg-portrait-picker="1"{{/if}} />
        {{#if editable}}
            <button type="button"
                    class="farkpg-portrait-edit"
                    data-action="editPortrait"
                    data-tooltip="{{localize 'FARKPG.Header.portraitEditBtn'}}"
                    aria-label="{{localize 'FARKPG.Header.portraitEditBtn'}}">
                <i class="fa-solid fa-image" aria-hidden="true"></i>
            </button>
        {{/if}}
    </div>

    <div class="farkpg-header-body">
        <div class="farkpg-header-row farkpg-header-name farkpg-header-name-row">
            <input type="text"
                   class="farkpg-header-name-input"
                   name="name"
                   value="{{actor.name}}"
                   placeholder="{{localize 'FARKPG.Header.name'}}" />
            {{#if editable}}
                <button type="button"
                        class="farkpg-header-import"
                        data-action="openCharacterImport"
                        data-tooltip="{{localize 'FARKPG.Import.buttonTooltip'}}"
                        aria-label="{{localize 'FARKPG.Import.buttonAria'}}">
                    {{localize "FARKPG.Import.button"}}
                </button>
            {{/if}}
        </div>

        <div class="farkpg-header-stats-block">
            <div class="farkpg-header-stats-row">
                <div class="farkpg-header-stat farkpg-header-stat-hp">
                    <div class="farkpg-header-stat-head">
                        <span class="farkpg-resource-delta-anchor">
                            {{#if editable}}
                                <button type="button"
                                        class="farkpg-header-icon-hit farkpg-header-hp-delta farkpg-header-icon-hit--hp farkpg-header-icon-hit--compact"
                                        data-tooltip="{{localize 'FARKPG.ResourceDelta.hpTooltip'}}"
                                        aria-label="{{localize 'FARKPG.ResourceDelta.hpAria'}}">
                                    <i class="fa-solid fa-heart" aria-hidden="true"></i>
                                </button>
                            {{else}}
                                <span class="farkpg-header-icon-hit farkpg-header-icon-readonly farkpg-header-icon-hit--hp farkpg-header-icon-hit--compact" aria-hidden="true">
                                    <i class="fa-solid fa-heart" aria-hidden="true"></i>
                                </span>
                            {{/if}}
                        </span>
                        <span class="farkpg-resource-label">{{localize 'FARKPG.Header.hp'}}</span>
                    </div>
                    <div class="farkpg-header-stat-values farkpg-resource-fields">
                        {{#if editable}}
                            <input type="number"
                                   class="farkpg-header-val-inp"
                                   name="system.resources.health.value"
                                   value="{{system.resources.health.value}}"
                                   min="0"
                                   step="1" />
                            <span class="farkpg-header-stat-slash">/</span>
                            <input type="number"
                                   class="farkpg-header-max-inp"
                                   name="system.resources.health.max"
                                   value="{{system.resources.health.max}}"
                                   min="0"
                                   step="1"
                                   data-tooltip="{{localize 'FARKPG.Config.maxHealth'}}" />
                        {{else}}
                            <span class="farkpg-header-read-val">{{resourceDisplay.hpValue}}</span>
                            <span class="farkpg-header-stat-slash">/</span>
                            <span class="farkpg-header-read-max">{{resourceDisplay.hpMax}}</span>
                        {{/if}}
                    </div>
                </div>

                <span class="farkpg-header-stat-divider" aria-hidden="true"></span>

                {{#each apTypes as |row|}}
                    <div class="farkpg-header-stat farkpg-header-stat-ap">
                        <div class="farkpg-header-stat-head">
                            <span class="farkpg-resource-delta-anchor">
                                {{#if @root.editable}}
                                    <button type="button"
                                            class="farkpg-header-icon-hit farkpg-header-ap-delta farkpg-header-icon-hit--ap farkpg-header-icon-hit--compact"
                                            data-tooltip="{{localize 'FARKPG.ResourceDelta.apTooltip'}}"
                                            aria-label="{{localize 'FARKPG.ResourceDelta.apAria'}}">
                                        <i class="fa-solid fa-coins" aria-hidden="true"></i>
                                    </button>
                                {{else}}
                                    <span class="farkpg-header-icon-hit farkpg-header-icon-readonly farkpg-header-icon-hit--ap farkpg-header-icon-hit--compact" aria-hidden="true">
                                        <i class="fa-solid fa-coins" aria-hidden="true"></i>
                                    </span>
                                {{/if}}
                            </span>
                            <span class="farkpg-resource-label">{{localize 'FARKPG.Header.ap'}}</span>
                        </div>
                        <div class="farkpg-header-stat-ap-body">
                            <div class="farkpg-header-stat-values farkpg-resource-fields">
                                {{#if @root.editable}}
                                    <input type="number"
                                           class="farkpg-header-val-inp farkpg-ap-sheet-inp"
                                           name="{{row.valueInputName}}"
                                           data-ap-path="{{row.valuePath}}"
                                           value="{{row.value}}"
                                           min="0"
                                           {{#if row.max}}max="{{row.max}}"{{/if}}
                                           step="1" />
                                    <span class="farkpg-header-stat-slash">/</span>
                                    <input type="number"
                                           class="farkpg-header-max-inp"
                                           name="{{row.maxPath}}"
                                           data-ap-path="{{row.maxPath}}"
                                           value="{{row.max}}"
                                           min="0"
                                           step="1"
                                           data-tooltip="{{localize 'FARKPG.Config.maxAp'}}" />
                                {{else}}
                                    <span class="farkpg-header-read-val">{{row.valueDisplay}}</span>
                                    <span class="farkpg-header-stat-slash">/</span>
                                    <span class="farkpg-header-read-max">{{row.maxDisplay}}</span>
                                {{/if}}
                            </div>
                            <div class="farkpg-ap-chips-wrap farkpg-ap-white-pool farkpg-ap-sheet-cell farkpg-ac-cell farkpg-ac-cell--{{row.id}}"
                                 data-ap-id="{{row.id}}">
                                <div class="farkpg-ac-chip-mid">
                                    {{#if @root.editable}}
                                        <button type="button"
                                                class="farkpg-ac-icon-hit farkpg-ac-icon-hit--sheet"
                                                data-action="decrementApFromSheet"
                                                data-ap-id="{{row.id}}"
                                                data-tooltip="{{localize 'FARKPG.ApDrawer.decrementTooltip'}}"
                                                aria-label="{{localize 'FARKPG.ApDrawer.decrementAria'}}">
                                            {{> "farkpg.chip-stack"
                                                   chipClass=row.chipClass
                                                   chipCount=row.chipCount
                                                   chipColCount=row.chipColCount
                                                   chipCountClass=row.chipCountClass
                                                   chipColsClass=row.chipColsClass
                                                   chipOver=row.chipOver
                                                   chipStackSize="farkpg-chip-stack--sheet"}}
                                        </button>
                                    {{else}}
                                        {{> "farkpg.chip-stack"
                                               chipClass=row.chipClass
                                               chipCount=row.chipCount
                                               chipColCount=row.chipColCount
                                               chipCountClass=row.chipCountClass
                                               chipColsClass=row.chipColsClass
                                               chipOver=row.chipOver
                                               chipStackSize="farkpg-chip-stack--sheet"}}
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                    </div>
                {{/each}}

                <span class="farkpg-header-stat-divider" aria-hidden="true"></span>

                <div class="farkpg-header-stat farkpg-header-stat-exp">
                    <div class="farkpg-header-stat-head">
                        <span class="farkpg-resource-delta-anchor">
                            {{#if editable}}
                                <button type="button"
                                        class="farkpg-header-icon-hit farkpg-header-exp-delta farkpg-header-icon-hit--exp farkpg-header-icon-hit--compact"
                                        data-tooltip="{{localize 'FARKPG.ResourceDelta.expTooltip'}}"
                                        aria-label="{{localize 'FARKPG.ResourceDelta.expAria'}}">
                                    <i class="fa-solid fa-star" aria-hidden="true"></i>
                                </button>
                            {{else}}
                                <span class="farkpg-header-icon-readonly farkpg-header-icon-hit farkpg-header-icon-hit--exp farkpg-header-icon-hit--compact" aria-hidden="true">
                                    <i class="fa-solid fa-star" aria-hidden="true"></i>
                                </span>
                            {{/if}}
                        </span>
                        <span class="farkpg-resource-label">{{localize 'FARKPG.Header.exp'}}</span>
                    </div>
                    <div class="farkpg-header-stat-values farkpg-resource-fields">
                        {{#if editable}}
                            <input type="number"
                                   class="farkpg-header-val-inp"
                                   name="system.resources.exp.value"
                                   value="{{system.resources.exp.value}}"
                                   min="0"
                                   step="1" />
                            <span class="farkpg-header-stat-slash">/</span>
                            <input type="number"
                                   class="farkpg-header-max-inp"
                                   name="system.resources.exp.max"
                                   value="{{system.resources.exp.max}}"
                                   min="0"
                                   step="1"
                                   data-tooltip="{{localize 'FARKPG.Config.maxExp'}}" />
                        {{else}}
                            <span class="farkpg-header-read-val">{{resourceDisplay.expValue}}</span>
                            <span class="farkpg-header-stat-slash">/</span>
                            <span class="farkpg-header-read-max">{{resourceDisplay.expMax}}</span>
                        {{/if}}
                    </div>
                </div>

                <span class="farkpg-header-stat-divider" aria-hidden="true"></span>

                <div class="farkpg-header-stat farkpg-header-stat-move">
                    <div class="farkpg-header-stat-head">
                        <span class="farkpg-header-icon-hit farkpg-header-icon-readonly farkpg-header-icon-hit--move farkpg-header-icon-hit--compact"
                              aria-hidden="true">
                            <i class="fa-solid fa-shoe-prints" aria-hidden="true"></i>
                        </span>
                        <span class="farkpg-resource-label">{{localize 'FARKPG.Header.move'}}</span>
                    </div>
                    <div class="farkpg-header-stat-values farkpg-resource-fields">
                        {{#if editable}}
                            <input type="number"
                                   class="farkpg-header-val-inp farkpg-header-move-val"
                                   name="system.resources.movement"
                                   value="{{system.resources.movement}}"
                                   min="0"
                                   step="1" />
                        {{else}}
                            <span class="farkpg-header-read-val farkpg-header-move-val">{{resourceDisplay.move}}</span>
                        {{/if}}
                    </div>
                </div>
            </div>

            <div class="farkpg-header-drawer-row">
                <button type="button"
                        class="farkpg-ap-bar-btn farkpg-ap-bar-popout farkpg-header-drawer-btn"
                        data-action="openApDrawer"
                        data-tooltip="{{localize 'FARKPG.ApDrawer.openTooltip'}}"
                        aria-label="{{localize 'FARKPG.ApDrawer.openAria'}}">
                    <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
</header>
