<section class="tab farkpg-tab farkpg-tab-inventory {{tab.cssClass}}"
         data-group="primary"
         data-tab="inventory">

    <header class="farkpg-panel-header farkpg-cards-header">
        <h2>{{localize 'FARKPG.Inventory.title'}}</h2>
        <div class="farkpg-inventory-toolbar">
            <button type="button" class="farkpg-add-btn" data-action="createItem" data-item-type="weapon">
                <i class="fa-solid fa-plus"></i> {{localize 'FARKPG.Inventory.addWeapon'}}
            </button>
            <button type="button" class="farkpg-add-btn" data-action="createItem" data-item-type="consumable">
                <i class="fa-solid fa-plus"></i> {{localize 'FARKPG.Inventory.addConsumable'}}
            </button>
            <button type="button" class="farkpg-add-btn" data-action="createItem" data-item-type="equipment">
                <i class="fa-solid fa-plus"></i> {{localize 'FARKPG.Inventory.addEquipment'}}
            </button>
        </div>
        <div class="farkpg-slot-counter {{#if (gt slots.inventory.count slots.inventory.max)}}farkpg-slot-counter-over{{/if}}"
             aria-live="polite">
            <span class="farkpg-slot-counter-label">{{localize 'FARKPG.Inventory.slots'}}:</span>
            <span class="farkpg-slot-counter-value">
                {{slots.inventory.count}} / {{slots.inventory.max}}
            </span>
        </div>
    </header>

    {{#if inventoryItems.length}}
        <div class="farkpg-card-grid">
            {{#each inventoryItems as |item|}}
                {{> "farkpg.item-card" item=item isEquipped=false}}
            {{/each}}
        </div>
    {{else}}
        <p class="farkpg-empty">{{localize 'FARKPG.Inventory.empty'}}</p>
    {{/if}}
</section>
