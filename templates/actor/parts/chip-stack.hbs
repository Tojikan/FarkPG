{{!-- Up to 20 white chips: 4 columns × 5. Visibility applied via data-chip-count + applyChipStackVisibility(). --}}
<span class="farkpg-chips farkpg-chip-stack {{chipClass}} {{chipCountClass}} {{chipColsClass}}{{#if chipOver}} farkpg-chips-over{{/if}} {{chipStackSize}}"
      data-chip-count="{{chipCount}}"
      data-chip-cols="{{chipColCount}}"
      aria-hidden="true">
    <span class="farkpg-chip-column farkpg-chip-column--1">
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--1"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--2"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--3"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--4"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--5"></span>
    </span>
    <span class="farkpg-chip-column farkpg-chip-column--2">
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--6"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--7"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--8"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--9"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--10"></span>
    </span>
    <span class="farkpg-chip-column farkpg-chip-column--3">
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--11"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--12"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--13"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--14"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--15"></span>
    </span>
    <span class="farkpg-chip-column farkpg-chip-column--4">
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--16"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--17"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--18"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--19"></span>
        <span class="farkpg-chip farkpg-chip--disc farkpg-chip--20"></span>
    </span>
</span>
