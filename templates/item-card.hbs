<div class="{{cssClass}} farkpg-item-card type-{{item.type}}">
  <header class="card-header flexrow">
    <input class="card-title" name="name" type="text" value="{{item.name}}" />
    {{#if showDurability}}
    <div class="durability-pill" title="Durability">
      <i class="fas fa-shield-alt"></i>
      <input type="number" name="system.durability.value" value="{{system.durability.value}}" min="0" />
      <span>/</span>
      <span>{{system.durability.max}}</span>
    </div>
    {{/if}}
  </header>
  <div class="card-art">
    <img data-edit="img" src="{{item.img}}" title="{{item.name}}" />
  </div>
  <div class="card-desc">
    {{editor enrichedDescription target="system.description" button=true editable=editable owner=owner}}
  </div>
  {{#if isConsumable}}
  <div class="card-quantity flexrow">
    <label>Qty <input type="number" name="system.quantity.value" value="{{system.quantity.value}}" min="0" /></label>
    <span>/ {{system.quantity.max}}</span>
  </div>
  {{/if}}
  {{#if isWeapon}}
  <div class="card-weapon-extras">
    <label class="flexrow">Style
      <select name="system.weaponStyle">
        <option value="melee" {{#if meleeSelected}}selected{{/if}}>Melee</option>
        <option value="ranged" {{#if rangedSelected}}selected{{/if}}>Ranged</option>
      </select>
    </label>
    <label class="flexrow"><input type="checkbox" data-edit="system.ammo.enabled" {{checked system.ammo.enabled}} /> Ammo</label>
    {{#if system.ammo.enabled}}
    <label class="flexrow">{{localize "FARKPG.AttachAmmo"}}
      <select name="system.ammo.linkedConsumableId">
        <option value="">—</option>
        {{#each consumableChoices as |c|}}
        <option value="{{c.id}}" {{#if c.selected}}selected{{/if}}>{{c.name}} ({{c.qty}})</option>
        {{/each}}
      </select>
    </label>
    <label>Per use <input type="number" name="system.ammo.perUse" value="{{system.ammo.perUse}}" min="1" /></label>
    {{/if}}
    <button type="button" class="card-use-weapon">{{localize "FARKPG.UseWeapon"}}</button>
    <p class="macro-hint">{{localize "FARKPG.MacroUse"}} <code>{{localize "FARKPG.MacroExample"}}</code></p>
  </div>
  {{/if}}
  {{#if showRollable}}
  <div class="card-rollable">{{system.rollable.multiplier}}×{{system.rollable.max}}</div>
  {{/if}}
</div>
