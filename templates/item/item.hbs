<section class="farkpg-item-sheet">

    <header class="farkpg-item-header">
        <button type="button"
                class="farkpg-item-image-btn"
                data-action="editImage"
                data-tooltip="{{localize 'FARKPG.Items.imageEdit'}}"
                aria-label="{{localize 'FARKPG.Items.imageEdit'}}">
            <img class="farkpg-item-icon" src="{{item.img}}" alt="{{item.name}}" />
            <span class="farkpg-item-image-edit">
                <i class="fa-solid fa-camera"></i>
            </span>
        </button>
        <div class="farkpg-item-header-fields">
            <input type="text"
                   class="farkpg-item-name"
                   name="name"
                   value="{{item.name}}"
                   placeholder="{{localize 'DOCUMENT.Item'}}" />
            <span class="farkpg-item-type-badge">{{item.type}}</span>
        </div>
    </header>

    <div class="farkpg-item-body">

        <fieldset class="farkpg-fieldset farkpg-description">
            <legend>{{localize 'FARKPG.Items.description'}}</legend>
            <div class="editor">
                {{#if editable}}
                    <prose-mirror name="system.description"
                                  value="{{system.description}}"
                                  document-uuid="{{item.uuid}}"></prose-mirror>
                {{else}}
                    <div class="editor-content">{{{descriptionHTML}}}</div>
                {{/if}}
            </div>
        </fieldset>

        {{#if isWeapon}}
            <fieldset class="farkpg-fieldset">
                <legend>{{localize 'FARKPG.Items.weapon'}}</legend>

                <div class="farkpg-item-toggles">
                    <label class="farkpg-toggle">
                        <input type="checkbox" name="system.rollable.enabled" {{#if system.rollable.enabled}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.rollEnabled'}}</span>
                    </label>
                    <label class="farkpg-toggle">
                        <input type="checkbox" name="system.ammo.enabled" {{#if system.ammo.enabled}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.ammoEnabled'}}</span>
                    </label>
                    <label class="farkpg-toggle">
                        <input type="checkbox" name="system.durabilityEnabled" {{#if system.durabilityEnabled}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.durabilityEnabled'}}</span>
                    </label>
                    <label class="farkpg-toggle">
                        <input type="checkbox" name="system.isEquipped" {{#if system.isEquipped}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.equipped'}}</span>
                    </label>
                </div>

                <label>
                    <span>{{localize 'FARKPG.Items.style'}}</span>
                    <select name="system.weaponStyle">
                        <option value="melee" {{#if (eq system.weaponStyle 'melee')}}selected{{/if}}>{{localize 'FARKPG.Items.styleMelee'}}</option>
                        <option value="ranged" {{#if (eq system.weaponStyle 'ranged')}}selected{{/if}}>{{localize 'FARKPG.Items.styleRanged'}}</option>
                        <option value="thrown" {{#if (eq system.weaponStyle 'thrown')}}selected{{/if}}>{{localize 'FARKPG.Items.styleThrown'}}</option>
                        <option value="unarmed" {{#if (eq system.weaponStyle 'unarmed')}}selected{{/if}}>{{localize 'FARKPG.Items.styleUnarmed'}}</option>
                    </select>
                </label>

                {{#if system.durabilityEnabled}}
                    <label>
                        <span>{{localize 'FARKPG.Items.durability'}}</span>
                        <span class="farkpg-pair">
                            <input type="number" name="system.durability.value" value="{{system.durability.value}}" min="0" step="1" />
                            <span class="farkpg-sep">/</span>
                            <input type="number" name="system.durability.max" value="{{system.durability.max}}" min="0" step="1" />
                        </span>
                    </label>
                    <label class="farkpg-toggle" data-tooltip="{{localize 'FARKPG.Items.restoreEnabledHint'}}">
                        <input type="checkbox" name="system.restoreEnabled" {{#if system.restoreEnabled}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.restoreEnabled'}}</span>
                    </label>
                    {{#if system.restoreEnabled}}
                        <label>
                            <span>{{localize 'FARKPG.Items.restoreFrom'}}</span>
                            {{#if hasActor}}
                                <select name="system.restoreFromId">
                                    <option value="">{{localize 'FARKPG.Items.restoreFromNone'}}</option>
                                    {{#each actorConsumables as |c|}}
                                        <option value="{{c.id}}" {{#if (eq c.id ../system.restoreFromId)}}selected{{/if}}>{{c.name}}</option>
                                    {{/each}}
                                </select>
                            {{else}}
                                <input type="text" value="{{localize 'FARKPG.Items.ammoNoConsumables'}}" disabled />
                            {{/if}}
                        </label>
                    {{/if}}
                {{/if}}

                {{#if system.rollable.enabled}}
                    <label data-tooltip="{{localize 'FARKPG.Items.damageBaseHint'}}">
                        <span>{{localize 'FARKPG.Items.damageBase'}}</span>
                        <input type="number" name="system.damage.base" value="{{system.damage.base}}" min="0" step="0.1" />
                    </label>
                    <label data-tooltip="{{localize 'FARKPG.Items.damageAdditionalHint'}}">
                        <span>{{localize 'FARKPG.Items.damageAdditional'}}</span>
                        <input type="number" name="system.damage.additional" value="{{system.damage.additional}}" min="0" step="0.1" />
                    </label>
                    <label data-tooltip="{{localize 'FARKPG.Items.attachedSkillHint'}}">
                        <span>{{localize 'FARKPG.Items.attachedSkill'}}</span>
                        <select name="system.rollable.attachedSkill">
                            <option value="">{{localize 'FARKPG.Items.attachedSkillNone'}}</option>
                            {{#each attachedSkillOptions as |opt|}}
                                <option value="{{opt.value}}" {{#if (eq opt.value ../system.rollable.attachedSkill)}}selected{{/if}}>{{opt.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                {{/if}}

                {{#if system.ammo.enabled}}
                    <label data-tooltip="{{localize 'FARKPG.Items.ammoCurrentHint'}}">
                        <span>{{localize 'FARKPG.Items.ammoCurrent'}}</span>
                        <span class="farkpg-pair">
                            <input type="number" name="system.ammo.value" value="{{system.ammo.value}}" min="0" step="1" />
                            <span class="farkpg-sep">/</span>
                            <input type="number" name="system.ammo.max" value="{{system.ammo.max}}" min="0" step="1"
                                   data-tooltip="{{localize 'FARKPG.Items.ammoMaxHint'}}" />
                        </span>
                    </label>
                    <label class="farkpg-toggle" data-tooltip="{{localize 'FARKPG.Items.reloadEnabledHint'}}">
                        <input type="checkbox" name="system.ammo.reloadEnabled" {{#if system.ammo.reloadEnabled}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.reloadEnabled'}}</span>
                    </label>
                    {{#if system.ammo.reloadEnabled}}
                        <label>
                            <span>{{localize 'FARKPG.Items.reloadFrom'}}</span>
                            {{#if hasActor}}
                                <select name="system.ammo.reloadFromId">
                                    <option value="">{{localize 'FARKPG.Items.reloadFromNone'}}</option>
                                    {{#each actorConsumables as |c|}}
                                        <option value="{{c.id}}" {{#if (eq c.id ../system.ammo.reloadFromId)}}selected{{/if}}>{{c.name}}</option>
                                    {{/each}}
                                </select>
                            {{else}}
                                <input type="text" value="{{localize 'FARKPG.Items.ammoNoConsumables'}}" disabled />
                            {{/if}}
                        </label>
                        <label>
                            <span>{{localize 'FARKPG.Items.requiredAmmo'}}</span>
                            <input type="text"
                                   name="system.ammo.requiredNames"
                                   value="{{system.ammo.requiredNames}}"
                                   placeholder="9mm, .45 ACP, ..."
                                   data-tooltip="{{localize 'FARKPG.Items.requiredAmmoHint'}}" />
                        </label>
                    {{/if}}
                {{/if}}
            </fieldset>
        {{/if}}

        {{#if isConsumable}}
            <fieldset class="farkpg-fieldset">
                <legend>{{localize 'FARKPG.Items.consumable'}}</legend>

                <div class="farkpg-item-toggles">
                    <label class="farkpg-toggle">
                        <input type="checkbox" name="system.rollable.enabled" {{#if system.rollable.enabled}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.rollEnabled'}}</span>
                    </label>
                    <label class="farkpg-toggle">
                        <input type="checkbox" name="system.isEquipped" {{#if system.isEquipped}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.equipped'}}</span>
                    </label>
                </div>

                <label>
                    <span>{{localize 'FARKPG.Items.quantity'}}</span>
                    <span class="farkpg-pair">
                        <input type="number" name="system.quantity.value" value="{{system.quantity.value}}" min="0" step="1" />
                        <span class="farkpg-sep">/</span>
                        <input type="number" name="system.quantity.max" value="{{system.quantity.max}}" min="0" step="1" />
                    </span>
                </label>

                {{#if system.rollable.enabled}}
                    <label data-tooltip="{{localize 'FARKPG.Items.rollMultiplierHint'}}">
                        <span>{{localize 'FARKPG.Items.rollMultiplier'}}</span>
                        <input type="number" name="system.rollable.multiplier" value="{{system.rollable.multiplier}}" min="0" step="1" />
                    </label>
                    <label data-tooltip="{{localize 'FARKPG.Items.rollMaxHint'}}">
                        <span>{{localize 'FARKPG.Items.rollMax'}}</span>
                        <input type="number" name="system.rollable.max" value="{{system.rollable.max}}" min="0" step="1" />
                    </label>
                    <label data-tooltip="{{localize 'FARKPG.Items.attachedSkillHint'}}">
                        <span>{{localize 'FARKPG.Items.attachedSkill'}}</span>
                        <select name="system.rollable.attachedSkill">
                            <option value="">{{localize 'FARKPG.Items.attachedSkillNone'}}</option>
                            {{#each attachedSkillOptions as |opt|}}
                                <option value="{{opt.value}}" {{#if (eq opt.value ../system.rollable.attachedSkill)}}selected{{/if}}>{{opt.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                {{/if}}
            </fieldset>
        {{/if}}

        {{#if isEquipment}}
            <fieldset class="farkpg-fieldset">
                <legend>{{localize 'FARKPG.Items.equipment'}}</legend>

                <div class="farkpg-item-toggles">
                    <label class="farkpg-toggle">
                        <input type="checkbox" name="system.rollable.enabled" {{#if system.rollable.enabled}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.rollEnabled'}}</span>
                    </label>
                    <label class="farkpg-toggle">
                        <input type="checkbox" name="system.isEquipped" {{#if system.isEquipped}}checked{{/if}} />
                        <span>{{localize 'FARKPG.Items.equipped'}}</span>
                    </label>
                </div>

                <label>
                    <span>{{localize 'FARKPG.Items.durability'}}</span>
                    <span class="farkpg-pair">
                        <input type="number" name="system.durability.value" value="{{system.durability.value}}" min="0" step="1" />
                        <span class="farkpg-sep">/</span>
                        <input type="number" name="system.durability.max" value="{{system.durability.max}}" min="0" step="1" />
                    </span>
                </label>

                {{#if system.rollable.enabled}}
                    <label data-tooltip="{{localize 'FARKPG.Items.rollMultiplierHint'}}">
                        <span>{{localize 'FARKPG.Items.rollMultiplier'}}</span>
                        <input type="number" name="system.rollable.multiplier" value="{{system.rollable.multiplier}}" min="0" step="1" />
                    </label>
                    <label data-tooltip="{{localize 'FARKPG.Items.rollMaxHint'}}">
                        <span>{{localize 'FARKPG.Items.rollMax'}}</span>
                        <input type="number" name="system.rollable.max" value="{{system.rollable.max}}" min="0" step="1" />
                    </label>
                    <label data-tooltip="{{localize 'FARKPG.Items.attachedSkillHint'}}">
                        <span>{{localize 'FARKPG.Items.attachedSkill'}}</span>
                        <select name="system.rollable.attachedSkill">
                            <option value="">{{localize 'FARKPG.Items.attachedSkillNone'}}</option>
                            {{#each attachedSkillOptions as |opt|}}
                                <option value="{{opt.value}}" {{#if (eq opt.value ../system.rollable.attachedSkill)}}selected{{/if}}>{{opt.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                {{/if}}

                <label data-tooltip="{{localize 'FARKPG.Items.equipmentSlotsBonusHint'}}">
                    <span>{{localize 'FARKPG.Items.equipmentSlotsBonus'}}</span>
                    <input type="number" name="system.equipmentSlots" value="{{system.equipmentSlots}}" min="0" step="1" />
                </label>
                <label data-tooltip="{{localize 'FARKPG.Items.inventorySlotsBonusHint'}}">
                    <span>{{localize 'FARKPG.Items.inventorySlotsBonus'}}</span>
                    <input type="number" name="system.inventorySlots" value="{{system.inventorySlots}}" min="0" step="1" />
                </label>
            </fieldset>
        {{/if}}

        {{#if isAbility}}
            <fieldset class="farkpg-fieldset">
                <legend>{{localize 'FARKPG.Items.ability'}}</legend>
                <label>
                    <span>{{localize 'FARKPG.Items.cost'}}</span>
                    <input type="text"
                           name="system.cost"
                           value="{{system.cost}}"
                           placeholder="{{localize 'FARKPG.Items.costPlaceholder'}}" />
                </label>
                <label>
                    <span>{{localize 'FARKPG.Items.rank'}}</span>
                    <span class="farkpg-pair">
                        <input type="number" name="system.rank" value="{{system.rank}}" min="0" step="1" />
                        <span class="farkpg-sep">/</span>
                        <input type="number" name="system.maxRank" value="{{system.maxRank}}" min="0" step="1" />
                    </span>
                </label>
            </fieldset>
        {{/if}}

        {{!-- Weapon / consumable / equipment fieldsets each render their own
              "Equipped" toggle in the farkpg-item-toggles row; abilities have
              no equipped state. So no separate fallback block is needed. --}}

    </div>
</section>
