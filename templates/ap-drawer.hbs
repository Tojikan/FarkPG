<div class="farkpg-ap-drawer-window">
    <div class="farkpg-drawer-health-row">
        <div class="farkpg-drawer-health-cell">
            <div class="farkpg-ap-drawer-label">{{localize 'FARKPG.ApDrawer.healthLabel'}}</div>
            <div class="farkpg-drawer-health-value">
                <span class="farkpg-drawer-health-icon" aria-hidden="true">
                    <i class="fa-solid fa-heart"></i>
                </span>
                {{#if editable}}
                    <input type="number"
                           class="farkpg-ap-drawer-inp farkpg-drawer-health-inp"
                           data-farkpg-health-value="1"
                           value="{{health.value}}"
                           min="0"
                           step="1"
                           data-tooltip="{{localize 'FARKPG.ApDrawer.healthCurrentTooltip'}}" />
                {{else}}
                    <span class="farkpg-ap-drawer-read-val">{{health.valueDisplay}}</span>
                {{/if}}
                <span class="farkpg-ap-drawer-slash">/</span>
                <span class="farkpg-ap-drawer-read-max">{{health.maxDisplay}}</span>
            </div>
        </div>
        {{#if editable}}
            <div class="farkpg-drawer-health-adjust">
                <div class="farkpg-ap-drawer-label">{{localize 'FARKPG.ApDrawer.healthDeltaLabel'}}</div>
                <div class="farkpg-drawer-health-adjust-row">
                    <button type="button"
                            class="farkpg-drawer-health-btn farkpg-drawer-health-btn-minus"
                            data-action="adjustHealth"
                            data-direction="-1"
                            data-tooltip="{{localize 'FARKPG.ApDrawer.healthDecrease'}}"
                            aria-label="{{localize 'FARKPG.ApDrawer.healthDecrease'}}">
                        <i class="fa-solid fa-minus" aria-hidden="true"></i>
                    </button>
                    <input type="number"
                           class="farkpg-ap-drawer-inp farkpg-drawer-health-delta"
                           value="1"
                           min="1"
                           step="1"
                           data-tooltip="{{localize 'FARKPG.ApDrawer.healthDeltaTooltip'}}" />
                    <button type="button"
                            class="farkpg-drawer-health-btn farkpg-drawer-health-btn-plus"
                            data-action="adjustHealth"
                            data-direction="1"
                            data-tooltip="{{localize 'FARKPG.ApDrawer.healthIncrease'}}"
                            aria-label="{{localize 'FARKPG.ApDrawer.healthIncrease'}}">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        {{/if}}
    </div>

    <div class="farkpg-ap-drawer-row">
        {{#each apTypes as |row|}}
            <div class="farkpg-ap-drawer-cell" data-ap-kind="{{row.kind}}" data-ap-id="{{row.id}}">
                <div class="farkpg-ap-drawer-label">{{row.label}}</div>
                <div class="farkpg-ap-drawer-mid">
                    {{#if @root.editable}}
                        <button type="button"
                                class="farkpg-ap-drawer-icon-btn"
                                data-action="decrementApFromDrawer"
                                data-ap-kind="{{row.kind}}"
                                {{#if (eq row.kind "custom")}}data-ap-id="{{row.id}}"{{/if}}
                                data-tooltip="{{localize 'FARKPG.ApDrawer.decrementTooltip'}}"
                                aria-label="{{localize 'FARKPG.ApDrawer.decrementAria'}}">
                            <img src="{{row.img}}" alt="" />
                        </button>
                    {{else}}
                        <span class="farkpg-ap-drawer-icon-readonly">
                            <img src="{{row.img}}" alt="" />
                        </span>
                    {{/if}}
                </div>
                <div class="farkpg-ap-drawer-frac">
                    {{#if @root.editable}}
                        <input type="number"
                               class="farkpg-ap-drawer-inp farkpg-ap-drawer-inp-val"
                               data-ap-path="{{row.valuePath}}"
                               value="{{row.value}}"
                               min="0"
                               step="1" />
                    {{else}}
                        <span class="farkpg-ap-drawer-read-val">{{row.valueDisplay}}</span>
                    {{/if}}
                    {{#if row.hasMax}}
                        <span class="farkpg-ap-drawer-slash">/</span>
                        <span class="farkpg-ap-drawer-read-max">{{row.maxDisplay}}</span>
                    {{/if}}
                </div>
            </div>
        {{/each}}
    </div>
</div>
