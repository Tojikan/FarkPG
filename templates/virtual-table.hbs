<section class="vdt-root">
    <nav class="vdt-board-tabs" aria-label="{{vdtL10n 'boardPickerAria'}}">
        {{#each boardTabs}}
        <button type="button" class="vdt-board-tab {{#if active}}active{{/if}} {{#if isGmPrivate}}gm-private{{/if}}"
            data-board-id="{{id}}">{{label}}</button>
        {{/each}}
    </nav>

    {{#if spectatorHint}}
    <p class="vdt-hint"><i class="fa-solid fa-eye"></i> {{vdtL10n "spectatorHint"}}</p>
    {{/if}}

    <div class="vdt-toolbar">
        <div class="vdt-toolbar-start">
            <label class="vdt-field">{{vdtL10n "count"}}
                <input type="number" name="vdt-count" min="0" max="{{maxDice}}" value="6" {{#unless canMutate}}disabled{{/unless}} />
            </label>
            <label class="vdt-field">{{vdtL10n "dieType"}}
                <select name="vdt-faces" {{#unless canMutate}}disabled{{/unless}}>
                    <option value="4" {{#if (eq faces 4)}}selected{{/if}}>d4</option>
                    <option value="6" {{#if (eq faces 6)}}selected{{/if}}>d6</option>
                    <option value="8" {{#if (eq faces 8)}}selected{{/if}}>d8</option>
                    <option value="10" {{#if (eq faces 10)}}selected{{/if}}>d10</option>
                    <option value="12" {{#if (eq faces 12)}}selected{{/if}}>d12</option>
                    <option value="20" {{#if (eq faces 20)}}selected{{/if}}>d20</option>
                </select>
            </label>
            <button type="button" class="vdt-btn" data-action="roll-new" {{#unless canMutate}}disabled{{/unless}}
                title="{{vdtL10n 'rollNew'}}"><i class="fa-solid fa-dice"></i> {{vdtL10n "rollNew"}}</button>
            <button type="button" class="vdt-btn" data-action="reroll-all-rolling" {{#unless canRerollAllRolling}}disabled{{/unless}}
                title="{{vdtL10n 'rerollAllRolling'}}"><i class="fa-solid fa-rotate"></i> {{vdtL10n "rerollAllRolling"}}</button>
        </div>
        <button type="button" class="vdt-btn danger vdt-toolbar-reset" data-action="reset-board" {{#unless canMutate}}disabled{{/unless}}
            title="{{vdtL10n 'resetBoard'}}"><i class="fa-solid fa-broom"></i> {{vdtL10n "resetBoard"}}</button>
    </div>

    <div class="vdt-regions">
        <div class="vdt-region vdt-region-roll vdt-drop-target" data-drop-region="table">
            <header>{{vdtL10n "table"}} <span class="vdt-help">{{vdtL10n "tableHelp"}}</span></header>
            <div class="vdt-table-surface">
                <div class="vdt-marquee-band" hidden aria-hidden="true"></div>
                {{#each tableDice}}
                <div class="vdt-die vdt-die-roll {{#if selected}}selected{{/if}}" draggable="true" data-die-id="{{id}}"
                    data-region="table" role="button" tabindex="0" aria-label="{{value}}"
                    data-faces="{{../faces}}" data-value="{{value}}">
                    {{#if (eq ../faces 6)}}
                    {{{d6FaceSvg value}}}
                    {{else}}
                    <span class="vdt-die-num">{{value}}</span>
                    {{/if}}
                </div>
                {{else}}
                <p class="vdt-empty">{{vdtL10n "emptyTable"}}</p>
                {{/each}}
            </div>
            {{#if showRerollSelected}}
            <div class="vdt-roll-footer">
                <button type="button" class="vdt-btn" data-action="reroll-selected"
                    title="{{vdtL10n 'rerollSelected'}}"><i class="fa-solid fa-rotate-right"></i> {{vdtL10n "rerollSelected"}}</button>
            </div>
            {{/if}}
        </div>
        <div class="vdt-region vdt-region-score vdt-drop-target" data-drop-region="zone" data-zone-target="new">
            <header>{{vdtL10n "zone"}}</header>
            <div class="vdt-zone-rows-wrap">
                {{#each zoneRows}}
                <div class="vdt-zone-row vdt-drop-target" data-drop-region="zone" data-zone-row-id="{{id}}">
                    <div class="vdt-zone-row-dice">
                        {{#each dice}}
                        <div class="vdt-die vdt-die-score zone {{#if selected}}selected{{/if}}" draggable="true" data-die-id="{{id}}"
                            data-region="zone" data-zone-row-id="{{../id}}" role="button" tabindex="0" aria-label="{{value}}"
                            data-faces="{{../../faces}}" data-value="{{value}}">
                            {{#if (eq ../../faces 6)}}
                            {{{d6FaceSvg value}}}
                            {{else}}
                            <span class="vdt-die-num">{{value}}</span>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
                <p class="vdt-zone-hint">{{vdtL10n "dragDiceToScore"}}</p>
            </div>
        </div>
    </div>
</section>
