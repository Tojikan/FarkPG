<section class="vdt-root">
    <nav class="vdt-board-tabs" aria-label="{{vdtL10n 'boardPickerAria'}}">
        {{#each boardTabs}}
        <button type="button" class="vdt-board-tab {{#if active}}active{{/if}} {{#if isGmPrivate}}gm-private{{/if}} {{#if isOverview}}vdt-board-tab-overview{{/if}} {{#if isShared}}vdt-board-tab-shared{{/if}}"
            data-board-id="{{id}}">{{label}}</button>
        {{/each}}
    </nav>

    {{#if showOverview}}
    <div class="vdt-overview">
        {{#if overviewPanels.length}}
        {{#each overviewPanels}}
        <article class="vdt-overview-card">
            <header class="vdt-overview-card-head">{{label}}</header>
            <div class="vdt-overview-card-body">
                <div class="vdt-overview-board">
                    <div class="vdt-overview-label">{{vdtL10n "table"}}</div>
                    <div class="vdt-overview-dice-row">
                        {{#each tableDice}}
                        <div class="vdt-die vdt-die-mini vdt-die-readonly" data-faces="{{../faces}}" data-value="{{value}}">
                            {{#if (eq ../faces 6)}}
                            {{{d6FaceSvg value}}}
                            {{else}}
                            <span class="vdt-die-num">{{value}}</span>
                            {{/if}}
                        </div>
                        {{else}}
                        <span class="vdt-overview-none">—</span>
                        {{/each}}
                    </div>
                </div>
                <aside class="vdt-overview-sidebar" aria-label="{{vdtL10n 'zone'}}">
                    <div class="vdt-overview-label">{{vdtL10n "zone"}}</div>
                    <div class="vdt-overview-score">
                        {{#each zoneRows}}
                        <div class="vdt-overview-zone-row">
                            {{#each dice}}
                            <div class="vdt-die vdt-die-mini vdt-die-readonly" data-faces="{{../../faces}}" data-value="{{value}}">
                                {{#if (eq ../../faces 6)}}
                                {{{d6FaceSvg value}}}
                                {{else}}
                                <span class="vdt-die-num">{{value}}</span>
                                {{/if}}
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <span class="vdt-overview-none">—</span>
                        {{/each}}
                    </div>
                </aside>
            </div>
        </article>
        {{/each}}
        {{else}}
        <p class="vdt-overview-empty">{{vdtL10n "overviewEmpty"}}</p>
        {{/if}}
    </div>
    {{else}}

    {{#if spectatorHint}}
    <p class="vdt-hint"><i class="fa-solid fa-eye"></i> {{vdtL10n "spectatorHint"}}</p>
    {{/if}}

    {{#if rollInProgress}}
    <div class="vdt-toolbar">
        <div class="vdt-toolbar-start">
            <label class="vdt-field">{{vdtL10n "count"}}
                <input type="number" name="vdt-count" min="0" max="{{maxDice}}" value="{{rollCountInput}}" {{#unless canMutate}}disabled{{/unless}} />
            </label>
            <label class="vdt-field">{{vdtL10n "dieType"}}
                <select name="vdt-faces" {{#unless canMutate}}disabled{{/unless}}>
                    <option value="4" {{#if (eq faces 4)}}selected{{/if}}>d4</option>
                    <option value="6" {{#if (eq faces 6)}}selected{{/if}}>d6</option>
                    <option value="8" {{#if (eq faces 8)}}selected{{/if}}>d8</option>
                    <option value="10" {{#if (eq faces 10)}}selected{{/if}}>d10</option>
                    <option value="12" {{#if (eq faces 12)}}selected{{/if}}>d12</option>
                    <option value="20" {{#if (eq faces 20)}}selected{{/if}}>d20</option>
                </select>
            </label>
            <button type="button" class="vdt-btn vdt-btn-roll" data-action="roll-new" {{#unless canMutate}}disabled{{/unless}}
                title="{{vdtL10n 'rollNew'}}"><i class="fa-solid fa-dice"></i> {{vdtL10n "rollNew"}}</button>
            <button type="button" class="vdt-btn vdt-btn-reroll-all" data-action="reroll-all-rolling" {{#unless canRerollAllRolling}}disabled{{/unless}}
                title="{{vdtL10n 'rerollAllRolling'}}"><i class="fa-solid fa-rotate"></i> {{vdtL10n "rerollAllRolling"}}</button>
        </div>
        {{#if canMutate}}
        <div class="vdt-toolbar-end">
            <button type="button" class="vdt-btn vdt-btn-end-roll-big vdt-btn-end-roll-toolbar" data-action="end-roll"
                title="{{vdtL10n 'endRoll'}}"><i class="fa-solid fa-stop"></i> {{vdtL10n "endRoll"}}</button>
        </div>
        {{/if}}
    </div>

    <div class="vdt-regions">
        <div class="vdt-region vdt-region-roll vdt-drop-target" data-drop-region="table">
            <header>{{vdtL10n "table"}} <span class="vdt-help">{{vdtL10n "tableHelp"}}</span></header>
            <div class="vdt-table-surface">
                <div class="vdt-marquee-band" hidden aria-hidden="true"></div>
                {{#each tableDice}}
                <div class="vdt-die vdt-die-roll {{#if selected}}selected{{/if}}" draggable="true" data-die-id="{{id}}"
                    data-region="table" role="button" tabindex="0" aria-label="{{value}}"
                    data-faces="{{../faces}}" data-value="{{value}}">
                    {{#if (eq ../faces 6)}}
                    {{{d6FaceSvg value}}}
                    {{else}}
                    <span class="vdt-die-num">{{value}}</span>
                    {{/if}}
                </div>
                {{else}}
                <p class="vdt-empty">{{vdtL10n "emptyTable"}}</p>
                {{/each}}
            </div>
            {{#if showRerollSelected}}
            <div class="vdt-roll-footer">
                <button type="button" class="vdt-btn" data-action="reroll-selected"
                    title="{{vdtL10n 'rerollSelected'}}"><i class="fa-solid fa-rotate-right"></i> {{vdtL10n "rerollSelected"}}</button>
            </div>
            {{/if}}
        </div>
        <div class="vdt-region vdt-region-score vdt-drop-target" data-drop-region="zone" data-zone-target="new">
            <header>{{vdtL10n "zone"}}</header>
            <div class="vdt-zone-rows-wrap">
                {{#each zoneRows}}
                <div class="vdt-zone-row vdt-drop-target" data-drop-region="zone" data-zone-row-id="{{id}}">
                    <div class="vdt-zone-row-dice">
                        {{#each dice}}
                        <div class="vdt-die vdt-die-score zone {{#if selected}}selected{{/if}}" draggable="true" data-die-id="{{id}}"
                            data-region="zone" data-zone-row-id="{{../id}}" role="button" tabindex="0" aria-label="{{value}}"
                            data-faces="{{../../faces}}" data-value="{{value}}">
                            {{#if (eq ../../faces 6)}}
                            {{{d6FaceSvg value}}}
                            {{else}}
                            <span class="vdt-die-num">{{value}}</span>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
                <p class="vdt-zone-hint">{{vdtL10n "dragDiceToScore"}}</p>
            </div>
            {{#if canMutate}}
            <div class="vdt-score-footer">
                <button type="button" class="vdt-btn vdt-btn-reset-score-footer" data-action="reset-score"
                    title="{{vdtL10n 'resetScore'}}">{{vdtL10n "resetScore"}}</button>
            </div>
            {{/if}}
        </div>
    </div>
    {{#if canMutate}}
    <div class="vdt-end-roll-wrap">
        <button type="button" class="vdt-btn vdt-btn-end-roll-big" data-action="end-roll"
            title="{{vdtL10n 'endRoll'}}"><i class="fa-solid fa-stop"></i> {{vdtL10n "endRoll"}}</button>
    </div>
    {{/if}}
    {{else}}
    <div class="vdt-roll-idle">
        {{#if canMutate}}
        <button type="button" class="vdt-btn vdt-btn-start-roll" data-action="start-roll">{{vdtL10n "startRoll"}}</button>
        {{else}}
        <p class="vdt-roll-idle-msg">{{vdtL10n "rollNotStarted"}}</p>
        {{/if}}
    </div>
    {{/if}}

    {{/if}}
</section>
