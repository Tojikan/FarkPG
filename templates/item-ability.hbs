<div class="{{cssClass}} farkpg-ability-sheet">
  <header class="ability-header flexrow">
    <img data-edit="img" src="{{item.img}}" height="48" width="48" />
    <input class="ability-title" name="name" type="text" value="{{item.name}}" />
  </header>
  <div class="ability-fields flexrow">
    <label>Cost <input type="number" name="system.cost" value="{{system.cost}}" min="0" /></label>
    <label>Rank <input type="number" name="system.rank" value="{{system.rank}}" min="1" /></label>
    <label>Max rank <input type="number" name="system.maxRank" value="{{system.maxRank}}" min="1" /></label>
  </div>
  <section class="ability-desc">
    {{editor enrichedDescription target="system.description" button=true editable=editable owner=owner}}
  </section>
</div>
