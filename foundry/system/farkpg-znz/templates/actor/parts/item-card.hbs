{{!-- Reusable item card. Inputs:
       item       (decorated item from prepareContext)
       isEquipped (boolean) — controls toggle icon
       compact    (boolean, optional) — drawer mini card, no description
--}}
<article class="farkpg-card farkpg-card-{{item.type}}{{#if compact}} farkpg-card--compact{{/if}}"
         data-item-id="{{item.id}}"
         data-uuid="{{item.uuid}}"
         draggable="true">
    <div class="farkpg-card-controls">
        <button type="button"
                class="farkpg-card-ctrl"
                data-action="editItem"
                data-tooltip="{{localize 'FARKPG.Items.edit'}}"
                aria-label="{{localize 'FARKPG.Items.edit'}}">
            <i class="fa-solid fa-pen-to-square"></i>
        </button>
        <button type="button"
                class="farkpg-card-ctrl"
                data-action="toggleEquip"
                data-tooltip="{{#if isEquipped}}{{localize 'FARKPG.Items.unequip'}}{{else}}{{localize 'FARKPG.Items.equip'}}{{/if}}"
                aria-label="{{#if isEquipped}}{{localize 'FARKPG.Items.unequip'}}{{else}}{{localize 'FARKPG.Items.equip'}}{{/if}}">
            <i class="fa-solid {{#if isEquipped}}fa-circle-minus{{else}}fa-circle-plus{{/if}}"></i>
        </button>
        <button type="button"
                class="farkpg-card-ctrl"
                data-action="deleteItem"
                data-tooltip="{{localize 'FARKPG.Items.delete'}}"
                aria-label="{{localize 'FARKPG.Items.delete'}}">
            <i class="fa-solid fa-trash"></i>
        </button>
    </div>

    <header class="farkpg-card-header">
        <span class="farkpg-card-name" title="{{item.name}}">{{item.name}}</span>
        {{#unless compact}}
            <span class="farkpg-card-type">{{item.typeLabel}}</span>
        {{/unless}}
    </header>

    <div class="farkpg-card-image">
        <img src="{{item.img}}" alt="" />
    </div>

    {{#unless compact}}
        {{#if item.descShort}}
            <div class="farkpg-card-desc">{{item.descShort}}</div>
        {{/if}}
    {{/unless}}

    <div class="farkpg-card-stats">
        {{#if item.usesDurability}}
            <div class="farkpg-card-stat {{#if item.isBroken}}farkpg-card-stat-broken{{/if}}"
                 data-tooltip="{{localize 'FARKPG.Items.durability'}}">
                <i class="fa-solid fa-screwdriver-wrench"></i>
                <span class="farkpg-card-stat-label">{{localize 'FARKPG.Items.durability'}}</span>
                <span class="farkpg-card-stat-value">{{item.durabilityValue}} / {{item.durabilityMax}}</span>
            </div>
        {{/if}}

        {{#if item.isConsumable}}
            <div class="farkpg-card-stat" data-tooltip="{{localize 'FARKPG.Items.quantity'}}">
                <i class="fa-solid fa-cubes-stacked"></i>
                <span class="farkpg-card-stat-label">{{localize 'FARKPG.Inventory.qty'}}</span>
                <span class="farkpg-card-stat-value">{{item.system.quantity.value}} / {{item.system.quantity.max}}</span>
            </div>
        {{/if}}

        {{#if item.hasSlotBonus}}
            <div class="farkpg-card-stat farkpg-card-stat-slots">
                <i class="fa-solid fa-vest"></i>
                <span class="farkpg-card-stat-label">{{localize 'FARKPG.Equipment.slots'}}</span>
                <span class="farkpg-card-stat-value farkpg-card-slot-bonuses">
                    {{#if item.equipmentSlotsBonus}}
                        <span class="farkpg-card-slot-bonus"
                              data-tooltip="{{localize 'FARKPG.Items.equipmentSlotsBonus'}}">
                            <i class="fa-solid fa-vest"></i>+{{item.equipmentSlotsBonus}}
                        </span>
                    {{/if}}
                    {{#if item.inventorySlotsBonus}}
                        <span class="farkpg-card-slot-bonus"
                              data-tooltip="{{localize 'FARKPG.Items.inventorySlotsBonus'}}">
                            <i class="fa-solid fa-box"></i>+{{item.inventorySlotsBonus}}
                        </span>
                    {{/if}}
                </span>
            </div>
        {{/if}}

        {{#if item.ammoEnabled}}
            <div class="farkpg-card-stat farkpg-card-stat-ammo"
                 data-tooltip="{{localize 'FARKPG.Items.ammoCurrentHint'}}">
                <i class="fa-solid fa-crosshairs"></i>
                <span class="farkpg-card-stat-label">{{localize 'FARKPG.Items.ammo'}}</span>
                <span class="farkpg-card-stat-value">{{item.ammoValue}} / {{item.ammoMax}}</span>
            </div>
        {{/if}}

        {{#if item.showDamage}}
            <div class="farkpg-card-stat farkpg-card-stat-damage"
                 data-tooltip="{{localize 'FARKPG.Items.damageAdditionalHint'}}">
                <i class="fa-solid fa-burst"></i>
                <span class="farkpg-card-stat-label">{{localize 'FARKPG.Items.damage'}}</span>
                <span class="farkpg-card-stat-value farkpg-card-damage-value">{{item.damageLabel}}</span>
            </div>
        {{/if}}

        {{#if item.isRollable}}
            <div class="farkpg-card-action-row">
                <button type="button"
                        class="farkpg-card-action-btn farkpg-card-use{{#if item.iconOnlyRoll}} farkpg-card-use-icon-only{{/if}}{{#if item.isBroken}} farkpg-card-use-broken{{/if}}"
                        data-action="useItem"
                        data-tooltip="{{#if item.isBroken}}{{item.brokenTooltip}}{{else}}{{item.useTooltip}}{{/if}}"
                        aria-label="{{localize 'FARKPG.Items.use'}}"
                        {{#if item.isBroken}}disabled{{/if}}>
                    {{#if item.iconOnlyRoll}}
                        <i class="fa-solid fa-bolt"></i>
                    {{else}}
                        <i class="fa-solid fa-hand-fist"></i>
                        <span class="farkpg-card-use-label">{{localize 'FARKPG.Items.use'}}</span>
                    {{/if}}
                </button>

                {{#if item.reloadEnabled}}
                    <div class="farkpg-card-supply-combo">
                        <button type="button"
                                class="farkpg-card-supply-main"
                                data-action="reloadAmmo"
                                data-tooltip="{{item.reloadTooltip}}"
                                aria-label="{{localize 'FARKPG.Items.reload'}}"
                                {{#unless item.canReload}}disabled{{/unless}}>
                            <i class="fa-solid fa-rotate"></i>
                            <span>{{localize 'FARKPG.Items.reload'}}</span>
                        </button>
                        {{#if item.reloadSource}}
                            <button type="button"
                                    class="farkpg-card-supply-pick"
                                    data-action="selectAmmo"
                                    data-tooltip="{{item.reloadSource.name}}"
                                    aria-label="{{item.reloadSource.name}}">
                                <img class="farkpg-card-ammo-img"
                                     src="{{item.reloadSource.img}}"
                                     alt=""
                                     data-ammo-id="{{item.reloadSource.id}}"
                                     data-tooltip="{{localize 'FARKPG.Items.editAmmoTooltip'}}" />
                                <span class="farkpg-card-ammo-qty">{{item.reloadSource.qty}}</span>
                            </button>
                        {{else}}
                            <button type="button"
                                    class="farkpg-card-supply-pick farkpg-card-supply-pick--empty"
                                    data-action="selectAmmo"
                                    data-tooltip="{{localize 'FARKPG.Items.selectReloadTooltip'}}"
                                    aria-label="{{localize 'FARKPG.Items.selectReloadTooltip'}}">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        {{/if}}
                    </div>
                {{/if}}

                {{#if item.restoreEnabled}}
                    <div class="farkpg-card-supply-combo">
                        <button type="button"
                                class="farkpg-card-supply-main"
                                data-action="restoreDurability"
                                data-tooltip="{{item.restoreTooltip}}"
                                aria-label="{{localize 'FARKPG.Items.restore'}}"
                                {{#unless item.canRestore}}disabled{{/unless}}>
                            <i class="fa-solid fa-wrench"></i>
                            <span>{{localize 'FARKPG.Items.restore'}}</span>
                        </button>
                        {{#if item.restoreSource}}
                            <button type="button"
                                    class="farkpg-card-supply-pick"
                                    data-action="selectRestore"
                                    data-tooltip="{{item.restoreSource.name}}"
                                    aria-label="{{item.restoreSource.name}}">
                                <img class="farkpg-card-ammo-img"
                                     src="{{item.restoreSource.img}}"
                                     alt=""
                                     data-ammo-id="{{item.restoreSource.id}}"
                                     data-tooltip="{{localize 'FARKPG.Items.editRestoreTooltip'}}" />
                                <span class="farkpg-card-ammo-qty">{{item.restoreSource.qty}}</span>
                            </button>
                        {{else}}
                            <button type="button"
                                    class="farkpg-card-supply-pick farkpg-card-supply-pick--empty"
                                    data-action="selectRestore"
                                    data-tooltip="{{localize 'FARKPG.Items.selectRestoreTooltip'}}"
                                    aria-label="{{localize 'FARKPG.Items.selectRestoreTooltip'}}">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        {{/if}}
                    </div>
                {{/if}}
            </div>
        {{/if}}
    </div>
</article>
